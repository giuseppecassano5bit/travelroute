PORT=3001
# In locale lascia vuoto per usare PGlite (file in .pglite/).
# In produzione è OBBLIGATORIA: connection string di Neon o Supabase (il server non parte senza).
DATABASE_URL=
# Sale per l'hash degli IP nel limite ricerche (obbligatorio in produzione)
IP_HASH_SECRET=cambia-questa-stringa-lunga-e-casuale
CORS_ORIGIN=http://localhost:5173
# Nominatim richiede un contatto reale (i placeholder tipo example.com ricevono 403)
NOMINATIM_USER_AGENT=travelroute/0.1 (+https://tuo-dominio.it; contatto@tuo-dominio.it)
# Ricerche itinerario al giorno per IP (non ci sono account)
DAILY_SEARCHES=15
# Transitous (tratte via terra). Condizioni: progetto open source e non commerciale, User-Agent con
# nome app, versione e contatto reale. Se vuota si usa NOMINATIM_USER_AGENT.
TRANSITOUS_USER_AGENT=travelroute/0.1 (+https://github.com/giuseppecassano5bit/travelroute; contatto@tuo-dominio.it)
# false = niente richieste a Transitous (restano solo le stime in auto)
TRANSITOUS_ENABLED=true
# Per quanti aeroporti per lato (i più vicini) calcolare i mezzi pubblici: ogni aeroporto = 1-2 richieste
TRANSITOUS_AIRPORTS_PER_SIDE=4
# Ore di validità della cache delle tratte via terra nel DB
GROUND_CACHE_HOURS=24
