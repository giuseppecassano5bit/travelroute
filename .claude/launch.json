{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "motis-lab",
      "runtimeExecutable": "motis-lab/motis/motis",
      "runtimeArgs": [
        "server",
        "-d",
        "motis-lab/run/data"
      ],
      "port": 8090
    }
  ]
}
